<Window x:Class="music_player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexPlayer"
        Height="600"
        Width="1000">

    <Grid>

        <!-- ستون‌های اصلی -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ردیف‌های اصلی -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>


        <!-- ================= SIDEBAR ================= -->

        <Border Grid.Column="0"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="#202020">

            <StackPanel>

                <TextBlock Text="NexPlayer"
                           FontSize="26"
                           Foreground="White"
                           Margin="20"/>

                <Button Content="Home"
                        Margin="10"
                        Click="HomeButton_Click"/>

                <Button Content="Songs"
                        Margin="10"
                        Click="SongsButton_Click"/>

                <Button Content="Favorites"
                        Margin="10"
                        Click="FavoritesButton_Click"/>

                <Button Content="Albums"
                        Margin="10"
                        Click="AlbumsButton_Click"/>

                <Button Content="Artists"
                        Margin="10"
                        Click="ArtistsButton_Click"/>
                
                <StackPanel Margin="10">

                    <Button Content="+ New Playlist"
                            Click="CreatePlaylist_Click"
                            Margin="0,0,0,5"/>

                    <Button Content="Rename Playlist"
                            Click="RenamePlaylist_Click"
                            Margin="0,0,0,5"/>

                    <Button Content="Delete Playlist"
                            Click="DeletePlaylist_Click"/>
                    
                    <Button Content="+ Add Selected Song"
                            Click="AddSongToPlaylist_Click"
                            Margin="0,5,0,0"/>

                </StackPanel>


                <!-- Playlist List -->

                
                <ListBox x:Name="PlaylistList"
                         ItemsSource="{Binding Playlists}"
                         DisplayMemberPath="Name"
                         Margin="10"
                         Height="150"
                         SelectionChanged="PlaylistList_SelectionChanged"/>


                <Button Content="+ Add Music"
                        Margin="10"
                        Click="AddMusic_Click"/>

            </StackPanel>

        </Border>


        <!-- ================= MAIN CONTENT ================= -->

        <Grid Grid.Column="1"
              Grid.Row="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            

            <!-- Song List -->

            <TextBlock x:Name="PageTitle"
                       Text="Your Music"
                       FontSize="25"
                       Margin="20,10,20,20"/>
            
            <ListBox Grid.Row="1"
                     x:Name="SongList"
                     ItemsSource="{Binding Songs}"
                     Margin="20,0,20,20"
                     SelectionChanged="SongList_SelectionChanged">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <StackPanel Margin="10">

                            <TextBlock Text="{Binding Title}"
                                       FontSize="18"/>

                            <TextBlock Text="{Binding Artist}"
                                       Foreground="Gray"/>

                        </StackPanel>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </Grid>


        <!-- ================= PLAYER BAR ================= -->

        <Border Grid.Column="1"
                Grid.Row="1"
                Background="#181818">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="250"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="250"/>

                </Grid.ColumnDefinitions>


                <!-- اطلاعات آهنگ -->

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="20,0">

                    <TextBlock Text="No song selected"
                               Foreground="White"
                               FontSize="16"/>

                    <TextBlock Text="Unknown Artist"
                               Foreground="Gray"
                               FontSize="12"/>

                </StackPanel>


                <!-- کنترل‌های پخش -->

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">


                    <!-- Progress -->

                    <Slider x:Name="ProgressSlider"
                            Minimum="0"
                            Maximum="1"
                            Margin="10,0"
                            PreviewMouseLeftButtonDown="ProgressSlider_MouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="ProgressSlider_MouseLeftButtonUp"/>


                    <!-- Buttons -->

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">


                        <Button Content="⏮"
                                Width="40"
                                Height="30"
                                Margin="3"
                                Click="PreviousButton_Click"/>


                        <Button x:Name="PlayButton"
                                Content="▶"
                                Width="45"
                                Height="30"
                                Margin="3"
                                Click="PlayButton_Click"/>


                        <Button Content="⏭"
                                Width="40"
                                Height="30"
                                Margin="3"
                                Click="NextButton_Click"/>


                        <!-- Current Time -->

                        <TextBlock x:Name="CurrentTimeText"
                                   Text="00:00"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"/>


                        <TextBlock Text=" / "
                                   Foreground="Gray"
                                   VerticalAlignment="Center"/>


                        <!-- Duration -->

                        <TextBlock x:Name="DurationText"
                                   Text="00:00"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>


                        <!-- Remove Song -->

                        <Button Content="🗑"
                                Click="RemoveSong_Click"
                                Width="30"
                                Margin="5"/>

                    </StackPanel>

                </StackPanel>


                <!-- Volume -->

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10">

                    <TextBlock Text="🔊"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="5"/>

                    <Slider Width="150"
                            Minimum="0"
                            Maximum="100"
                            Value="50"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ================= AUDIO ENGINE ================= -->

        <MediaElement x:Name="AudioPlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"/>

    </Grid>

</Window>